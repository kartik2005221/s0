#!/bin/bash
# live-build chroot hook: install the s0 code tree + kiosk service.
# Runs inside the image build as root. No secrets are created here — see
# README.md for the key-provisioning posture.

set -e

echo "==> installing the s0 distribution into /opt/s0"
mkdir -p /opt/s0
# One importable package plus the static verifier it serves. The web dashboard
# now lives inside the package (s0/web), so there is no separate top-level web
# directory to copy. Only site/verify is staged: the rest of site/ is the
# landing page and the web installer, which have no place on the appliance.
cp -r /root/repo-snapshot/src /opt/s0/
if [ -d /root/repo-snapshot/site/verify ]; then
    mkdir -p /opt/s0/site
    cp -r /root/repo-snapshot/site/verify /opt/s0/site/
fi
if [ -f /root/repo-snapshot/pyproject.toml ]; then
    cp /root/repo-snapshot/pyproject.toml /opt/s0/
fi
if [ -f /root/repo-snapshot/s0_config.json ]; then
    mkdir -p /etc/s0
    cp /root/repo-snapshot/s0_config.json /etc/s0/s0_config.json
    cp /root/repo-snapshot/s0_config.json /opt/s0/s0_config.json
fi
if [ -d /root/repo-snapshot/vendor ]; then
    cp -r /root/repo-snapshot/vendor /opt/s0/
    echo "==> installing vendored pydantic v2 wheels"
    pip3 install --break-system-packages --no-deps /opt/s0/vendor/*.whl 2>/dev/null || \
    python3 -m pip install --break-system-packages --no-deps /opt/s0/vendor/*.whl 2>/dev/null || true
fi
chmod -R go-w /opt/s0

# s0 is a single package now, so one path entry makes the whole tool importable:
# CLI, carver, audit ledger, wipe planner and the web dashboard.
cat > /usr/lib/python3/dist-packages/s0_path.pth <<'EOF'
/opt/s0/src
EOF

echo "==> wrapper: s0 on PATH"
cat > /usr/local/bin/s0 <<'EOF'
#!/bin/sh
exec python3 -m s0.cli.main "$@"
EOF
cat > /usr/local/bin/s0-verify <<'EOF'
#!/bin/sh
exec python3 -m s0.certcli verify "$@"
EOF
chmod 0755 /usr/local/bin/s0 /usr/local/bin/s0-verify

echo "==> kiosk user and security group (s0-kiosk)"
# No `|| true` here. These swallowed every failure: if groupadd failed, the
# useradd -G failed, the usermod failed, and the hook exited 0 having created no
# kiosk user at all. The web tier then fell back to a 0600 root-owned token, the
# `s0` user could not read it, app.py swallowed that, and s0-kiosk.service sat in
# a Restart=always loop with nothing on the console. A build that cannot make the
# kiosk work should fail at build time, not at boot.
getent group s0-kiosk >/dev/null || groupadd -r s0-kiosk
if getent passwd s0 >/dev/null; then
    usermod -aG video,input,render,s0-kiosk s0
else
    useradd -m -s /bin/bash -G video,input,render,s0-kiosk s0
fi

# /run is a tmpfs: a directory created here does not exist at boot, so the
# 0750/root:s0-kiosk posture below never applied. s0-web.service now declares
# RuntimeDirectory=s0 with RuntimeDirectoryMode=0750, which systemd creates at
# boot with correct ownership and cleans up on stop.

echo "==> systemd services: local web dashboard server + chromium kiosk autostart"
# (unit files ship via config/includes.chroot)
for svc in s0-web s0-kiosk; do
    systemctl enable "$svc.service" 2>/dev/null || \
        ln -sf "/etc/systemd/system/$svc.service" \
            "/etc/systemd/system/multi-user.target.wants/$svc.service"
done
chmod 0755 /usr/local/bin/s0-wait-web
chmod 0644 /etc/systemd/system/s0-web.service /etc/systemd/system/s0-kiosk.service
