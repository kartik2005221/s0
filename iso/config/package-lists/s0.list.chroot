# Packages installed into the s0 live system (Debian names).
#
# Everything here comes from the Debian archive so the image builds offline
# after bootstrap; no pip at image-build time (reproducibility + no network).

linux-image-amd64
live-boot
systemd-sysv

# wipe tooling
hdparm
nvme-cli
util-linux

# s0 runtime (python3 stack)
python3
python3-cryptography
python3-reportlab
python3-qrcode
python3-pil
python3-fastapi
python3-uvicorn
# pip is needed at build time only: bookworm's python3-pydantic is v1, and
# s0.web.app imports pydantic v2 names, so 9000-s0.hook.chroot installs the
# vendored pydantic v2 wheels from vendor/ (offline, --no-deps). Without it the
# wheel install silently failed and the kiosk booted to a black screen.
python3-pip

# kiosk UI
chromium
cage
xwayland

# operator diagnostics
less
pciutils
usbutils
