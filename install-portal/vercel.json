{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/sh", "destination": "/install.sh" },
    { "source": "/ps1", "destination": "/install.ps1" },
    { "source": "/cmd", "destination": "/install.cmd" },
    { "source": "/upgrade", "destination": "/upgrade.sh" },
    { "source": "/upgrade-sh", "destination": "/upgrade.sh" },
    { "source": "/upgrade/sh", "destination": "/upgrade.sh" },
    { "source": "/upgrade-ps1", "destination": "/upgrade.ps1" },
    { "source": "/upgrade/ps1", "destination": "/upgrade.ps1" },
    { "source": "/upgrade-cmd", "destination": "/upgrade.cmd" },
    { "source": "/upgrade/cmd", "destination": "/upgrade.cmd" },
    { "source": "/uninstall", "destination": "/uninstall.sh" },
    { "source": "/uninstall-sh", "destination": "/uninstall.sh" },
    { "source": "/uninstall/sh", "destination": "/uninstall.sh" },
    { "source": "/uninstall-ps1", "destination": "/uninstall.ps1" },
    { "source": "/uninstall/ps1", "destination": "/uninstall.ps1" },
    { "source": "/uninstall-cmd", "destination": "/uninstall.cmd" },
    { "source": "/uninstall/cmd", "destination": "/uninstall.cmd" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(sh|ps1|cmd)",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(sh|ps1|cmd|upgrade|upgrade-sh|upgrade-ps1|upgrade-cmd|uninstall|uninstall-sh|uninstall-ps1|uninstall-cmd)",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
