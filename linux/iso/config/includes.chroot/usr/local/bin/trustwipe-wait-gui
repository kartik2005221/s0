#!/bin/sh
# Wait until the local TrustWipe GUI answers (max ~30 s), then hand over to kiosk.
i=0
while [ "$i" -lt 60 ]; do
    if python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/api/devices', timeout=1)" 2>/dev/null; then
        exit 0
    fi
    i=$((i + 1))
    sleep 0.5
done
echo "TrustWipe GUI did not come up on 127.0.0.1:8080" >&2
exit 1
