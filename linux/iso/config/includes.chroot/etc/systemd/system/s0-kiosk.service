[Unit]
Description=s0 wipe station — chromium kiosk UI
Requires=s0-gui.service
After=s0-gui.service

[Service]
User=s0
WorkingDirectory=/home/s0
ExecStartPre=/usr/local/bin/s0-wait-gui
ExecStart=/usr/bin/chromium --kiosk --noerrdialogs --disable-session-crashed-bubble \
    --app=http://127.0.0.1:8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
