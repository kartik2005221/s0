[Unit]
Description=s0 wipe station — local GUI server (uvicorn, loopback only)
After=multi-user.target

[Service]
User=root
Environment=S0_IMAGE_DIR=/opt/s0/images
WorkingDirectory=/opt/s0/gui
ExecStart=/usr/bin/python3 -m uvicorn app:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=3

# Loopback bind is a hard requirement: a wipe tool must not expose an
# erase-the-disk API to the network. Root execution is required on bare-metal
# live media to issue raw disk ioctls (BLKDISCARD, ATA Security Erase, NVMe Sanitize).
[Install]
WantedBy=multi-user.target
