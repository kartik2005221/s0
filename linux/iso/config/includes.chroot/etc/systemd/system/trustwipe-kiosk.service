[Unit]
Description=TrustWipe wipe station — chromium kiosk UI
Requires=trustwipe-gui.service
After=trustwipe-gui.service

[Service]
User=trustwipe
WorkingDirectory=/home/trustwipe
ExecStartPre=/usr/local/bin/trustwipe-wait-gui
ExecStart=/usr/bin/chromium --kiosk --noerrdialogs --disable-session-crashed-bubble \
    --app=http://127.0.0.1:8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
