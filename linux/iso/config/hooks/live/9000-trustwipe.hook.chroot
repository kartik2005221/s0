#!/bin/bash
# live-build chroot hook: install the TrustWipe code tree + kiosk service.
# Runs inside the image build as root. No secrets are created here — see
# README.md for the key-provisioning posture.

set -e

echo "==> installing TrustWipe core + CLI into /opt/trustwipe"
mkdir -p /opt/trustwipe
cp -r /root/repo-snapshot/core /opt/trustwipe/
rm -rf /opt/trustwipe/core/tests          # tests don't belong in the image
chmod -R go-w /opt/trustwipe

# The GUI imports the CLI package by path; make both importable system-wide.
cat > /usr/lib/python3/dist-packages/trustwipe_path.pth <<'EOF'
/opt/trustwipe/core/python
/opt/trustwipe/linux/cli
EOF

echo "==> wrapper: trustwipe-wipe on PATH"
cat > /usr/local/bin/trustwipe-wipe <<'EOF'
#!/bin/sh
exec python3 -m trustwipe_cli.main "$@"
EOF
cat > /usr/local/bin/trustwipe-verify <<'EOF'
#!/bin/sh
exec python3 -m trustwipe_core.cli verify "$@"
EOF
chmod 0755 /usr/local/bin/trustwipe-wipe /usr/local/bin/trustwipe-verify

echo "==> kiosk user (no password, no sudo)"
useradd -m -s /bin/bash -G video,input trustwipe || true

echo "==> systemd services: local GUI server + chromium kiosk autostart"
# (unit files ship via config/includes.chroot)
for svc in trustwipe-gui trustwipe-kiosk; do
    systemctl enable "$svc.service" 2>/dev/null || \
        ln -sf "/etc/systemd/system/$svc.service" \
            "/etc/systemd/system/multi-user.target.wants/$svc.service"
done
chmod 0755 /usr/local/bin/trustwipe-wait-gui
chmod 0644 /etc/systemd/system/trustwipe-gui.service /etc/systemd/system/trustwipe-kiosk.service
