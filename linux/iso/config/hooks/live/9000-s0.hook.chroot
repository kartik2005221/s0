#!/bin/bash
# live-build chroot hook: install the s0 code tree + kiosk service.
# Runs inside the image build as root. No secrets are created here — see
# README.md for the key-provisioning posture.

set -e

echo "==> installing s0 core + CLI + GUI into /opt/s0"
mkdir -p /opt/s0
cp -r /root/repo-snapshot/core /opt/s0/
cp -r /root/repo-snapshot/linux /opt/s0/
if [ -d /root/repo-snapshot/web ]; then
    cp -r /root/repo-snapshot/web /opt/s0/
    ln -sfn /opt/s0/web /opt/s0/gui
elif [ -d /root/repo-snapshot/gui ]; then
    cp -r /root/repo-snapshot/gui /opt/s0/
    ln -sfn /opt/s0/gui /opt/s0/web
fi
if [ -f /root/repo-snapshot/s0_config.json ]; then
    mkdir -p /etc/s0
    cp /root/repo-snapshot/s0_config.json /etc/s0/s0_config.json
    cp /root/repo-snapshot/s0_config.json /opt/s0/s0_config.json
fi
rm -rf /opt/s0/core/tests /opt/s0/linux/cli/tests /opt/s0/web/tests /opt/s0/gui/tests 2>/dev/null || true
chmod -R go-w /opt/s0


# The GUI imports the CLI package by path; make both importable system-wide.
cat > /usr/lib/python3/dist-packages/s0_path.pth <<'EOF'
/opt/s0/core/python
/opt/s0/linux/cli
EOF

echo "==> wrapper: s0 on PATH"
cat > /usr/local/bin/s0 <<'EOF'
#!/bin/sh
exec python3 -m s0_cli.main "$@"
EOF
cat > /usr/local/bin/s0-verify <<'EOF'
#!/bin/sh
exec python3 -m s0_core.cli verify "$@"
EOF
chmod 0755 /usr/local/bin/s0 /usr/local/bin/s0-verify

echo "==> kiosk user (no password, member of video, input, disk, render)"
useradd -m -s /bin/bash -G video,input,disk,render s0 || true

echo "==> systemd services: local GUI server + chromium kiosk autostart"
# (unit files ship via config/includes.chroot)
for svc in s0-gui s0-kiosk; do
    systemctl enable "$svc.service" 2>/dev/null || \
        ln -sf "/etc/systemd/system/$svc.service" \
            "/etc/systemd/system/multi-user.target.wants/$svc.service"
done
chmod 0755 /usr/local/bin/s0-wait-gui
chmod 0644 /etc/systemd/system/s0-gui.service /etc/systemd/system/s0-kiosk.service
