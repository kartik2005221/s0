# Packages installed into the s0 live system (Debian names).
#
# Everything here comes from the Debian archive so the image builds offline
# after bootstrap; no pip at image-build time (reproducibility + no network).

linux-image-amd64
live-boot
systemd-sysv

# wipe tooling
hdparm
nvme-cli
util-linux

# s0 runtime (python3 stack)
python3
python3-cryptography
python3-reportlab
python3-qrcode
python3-pil
python3-fastapi
python3-uvicorn

# kiosk UI
chromium
cage
xwayland

# operator diagnostics
less
pciutils
usbutils
