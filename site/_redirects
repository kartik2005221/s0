/ps1 /install/install.ps1 200
/cmd /install/install.cmd 200
/upgrade /install/upgrade.sh 200
/upgrade-sh /install/upgrade.sh 200
/upgrade/sh /install/upgrade.sh 200
/upgrade-ps1 /install/upgrade.ps1 200
/upgrade/ps1 /install/upgrade.ps1 200
/upgrade-cmd /install/upgrade.cmd 200
/upgrade/cmd /install/upgrade.cmd 200
/uninstall /install/uninstall.sh 200
/uninstall-sh /install/uninstall.sh 200
/uninstall/sh /install/uninstall.sh 200
/uninstall-ps1 /install/uninstall.ps1 200
/uninstall/ps1 /install/uninstall.ps1 200
/uninstall-cmd /install/uninstall.cmd 200
