# Cloudflare Pages response headers for the s0 Verification Portal.
#
# This portal exists to prove a certificate is authentic. Shipping it with
# 'unsafe-inline' in script-src would undercut the point: any injected inline
# script could rewrite the verdict. The policy below is hash-based -- the two
# inline blocks in index.html are hashed here -- and the vendored libraries are
# pinned with Subresource Integrity in the HTML as well.
#
# Regenerate with: python tools/sync_csp.py --write

/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-4deiL2HqY9CkQzMfv2OmjkFD5LAvnGHDhCcWMGzERww='; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

/vendor/*
  Cache-Control: public, max-age=86400, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=86400
